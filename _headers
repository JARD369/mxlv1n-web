/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/*.html
  Cache-Control: no-cache, must-revalidate

/styles.css
  Cache-Control: no-cache, must-revalidate

/main.js
  Cache-Control: no-cache, must-revalidate

/lib/*
  Cache-Control: no-cache, must-revalidate

/assets/*
  Cache-Control: public, max-age=2592000
